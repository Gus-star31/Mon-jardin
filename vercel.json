{
  "functions": {
    "api/analyse.js": {
      "maxDuration": 60
    },
    "api/apercu.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/app/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/app/"
        }
      ]
    },
    {
      "source": "/app/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/app/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/app/",
      "permanent": false
    }
  ]
}
